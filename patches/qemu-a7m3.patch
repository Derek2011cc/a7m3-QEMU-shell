+/* --- live QEMU display of the Sugilite draw surface (PA 0x202e0200) --- */
+static QemuConsole *sugi_display_con;
+static QEMUTimer *sugi_display_timer;
+
+static void cxd90045_display_paint(void *opaque)
+{
+    DisplaySurface *surf;
+    uint8_t *dst;
+    int stride, x, y;
+    static uint16_t src[640 * 480];
+
+    if (!sugi_display_con) {
+        return;
+    }
+    surf = qemu_console_surface(sugi_display_con);
+    if (!surf) {
+        return;
+    }
+    dst = surface_data(surf);
+    stride = surface_stride(surf);
+    if (cxd90045_sugi_pa_ok(0x202e0200ULL, sizeof(src))) {
+        cpu_physical_memory_read(0x202e0200ULL, src, sizeof(src));
+        for (y = 0; y < 480; y++) {
+            uint32_t *row = (uint32_t *)(dst + (size_t)y * stride);
+            for (x = 0; x < 640; x++) {
+                uint16_t v = src[y * 640 + x];
+                uint32_t r = (v >> 12) & 15;
+                uint32_t g = (v >> 8) & 15;
+                uint32_t b = (v >> 4) & 15;
+                row[x] = (r * 17 << 16) | (g * 17 << 8) | (b * 17);
+            }
+        }
+        dpy_gfx_update(sugi_display_con, 0, 0, 640, 480);
+    }
+    timer_mod(sugi_display_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 40);
+}
+
+static const GraphicHwOps sugi_display_ops = {
+    .gfx_update = cxd90045_display_paint,
+};
+
+static void cxd90045_display_init(void)
+{
+    if (getenv("A7M3_NO_GFX_CONSOLE")) {
+        return;
+    }
+    if (sugi_display_con) {
+        return;
+    }
+    sugi_display_con = graphic_console_init(NULL, 0, &sugi_display_ops, NULL);
+    qemu_console_resize(sugi_display_con, 640, 480);
+    sugi_display_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                      cxd90045_display_paint, NULL);
+    timer_mod(sugi_display_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 500);
+}
